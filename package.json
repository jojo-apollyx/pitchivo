{
  "name": "pitchivo",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "debug": "NODE_OPTIONS='--inspect=9229' turbo run dev:debug --filter=web",
    "debug:clear-ports": "./scripts/clear-debug-ports.sh",
    "clean:rebuild": "./scripts/clean-rebuild.sh",
    "functions": "supabase functions serve --env-file .env.local",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset --local",
    "supabase:migrate": "supabase db push --local",
    "supabase:migrate:run": "node scripts/run-migration.js",
    "supabase:dump-schema": "node scripts/dump-schema.js",
    "supabase:deploy": "supabase functions deploy",
    "supabase:functions:serve": "supabase functions serve --env-file .env.local",
    "supabase:functions:serve:send-email": "supabase functions serve send-email --env-file .env.local",
    "migrate:mongodb": "tsx scripts/migration/mongodb/index.ts",
    "migrate:mongodb:prod": "tsx scripts/migration/mongodb/index.ts --env=.env.prod",
    "migrate:verify": "tsx scripts/migration/mongodb/verify.ts",
    "migrate:verify:prod": "tsx scripts/migration/mongodb/verify.ts --env=.env.prod",
    "enrich:organizations": "tsx scripts/migration/enrichment/pipeline.ts organizations",
    "enrich:organizations:prod": "tsx scripts/migration/enrichment/pipeline.ts organizations --env=.env.prod",
    "enrich:contacts": "tsx scripts/migration/enrichment/pipeline.ts contacts",
    "enrich:contacts:prod": "tsx scripts/migration/enrichment/pipeline.ts contacts --env=.env.prod",
    "generate:embeddings": "tsx scripts/generate-embeddings.ts",
    "generate:embeddings:prod": "tsx scripts/generate-embeddings.ts --env=.env.prod",
    "populate:contacts-org-id": "tsx scripts/populate-leads-contacts-org-id.ts",
    "populate:contacts-org-id:prod": "tsx scripts/populate-leads-contacts-org-id.ts --env=.env.prod"
  },
  "dependencies": {
    "@ai-sdk/azure": "^2.0.60",
    "@azure/storage-blob": "^12.17.0",
    "@supabase/supabase-js": "^2.45.4",
    "ai": "^5.0.87",
    "mongodb": "^6.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv": "^17.2.3",
    "supabase": "^2.51.0",
    "tsx": "^4.7.0",
    "turbo": "^2.0.3"
  }
}
